{
  "name": "@crossgram-project/website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/pages-fallback.mjs",
    "preview": "vite preview",
    "sync:releases": "node scripts/fetch-releases.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^8.3.5",
    "vitest": "^3.2.4"
  }
}

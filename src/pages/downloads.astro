---
import Base from '../layouts/Base.astro'
import DownloadExplorer from '../components/DownloadExplorer'
import releaseData from '../data/releases.json'
---
<Base title="下载 — CrossGram" description="按客户端、系统、品牌渠道与架构选择 CrossGram 构建。支持 Desktop、Android、Unigram、Telegram X 与 Mithka。">
  <section class="page-hero wrap">
    <p class="eyebrow">Choose your surface</p>
    <h1 class="title">很多种客户端，<br/><span class="gradient-text">只需要一个选择器。</span></h1>
    <p class="lead">从你喜欢的客户端开始，再选择系统和品牌渠道。我们会把数十个 Release 资产整理成一个推荐下载；架构、安装格式和历史构建需要时再展开。</p>
  </section>

  <section class="explorer-wrap wrap">
    <DownloadExplorer clients={releaseData.clients as any} client:load />
  </section>

  <section class="variant wrap" data-reveal>
    <p class="eyebrow">What is a channel?</p><h2>同一个客户端，<br/>可以为不同世界而生。</h2>
    <div class="variant-grid">
      <div><b>CrossGram</b><p>中性品牌，适合在同一个客户端内连接多个桥接平台。</p></div>
      <div><b>QQ / 微信 / 企业微信</b><p>独立图标与应用标识，适合多开并把每个平台清晰分开。</p></div>
      <div><b>钉钉 / Discord</b><p>同一套服务器切换能力，不同的视觉渠道与独立数据目录。</p></div>
      <div><b>更多版本</b><p>调试符号、校验文件和旧 Release 不占据主页面，可随时前往 GitHub 查看。</p></div>
    </div>
  </section>
</Base>
<style>
  .explorer-wrap{padding-bottom:30px}.variant{padding:140px 0}.variant h2{font-size:clamp(38px,5vw,64px);line-height:1.05;letter-spacing:-.05em}.variant-grid{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--line);border-left:1px solid var(--line)}.variant-grid div{padding:30px;border-right:1px solid var(--line);border-bottom:1px solid var(--line)}.variant-grid b{color:var(--acid)}.variant-grid p{color:var(--muted);font-size:14px;line-height:1.7}
  @media(max-width:800px){.variant-grid{grid-template-columns:1fr 1fr}}@media(max-width:520px){.variant-grid{grid-template-columns:1fr}}
</style>
<style is:global>
  .client-browser{display:grid;grid-template-columns:190px minmax(0,1fr);min-height:230px;border:1px solid var(--line);border-radius:22px;background:linear-gradient(145deg,rgba(20,25,29,.86),rgba(9,11,14,.8));overflow:hidden}.client-platforms{display:flex;flex-direction:column;gap:4px;padding:14px;border-right:1px solid var(--line);background:rgba(0,0,0,.16)}.platform-tab{display:grid;grid-template-columns:20px 1fr auto;align-items:center;gap:9px;width:100%;padding:11px 10px;border:1px solid transparent;border-radius:11px;background:transparent;color:var(--muted);cursor:pointer;text-align:left;transition:background .22s ease,border-color .22s ease,color .22s ease,transform .22s ease}.platform-tab:hover{transform:translateX(3px);background:rgba(255,255,255,.045);color:var(--white)}.platform-tab.active{border-color:rgba(167,255,131,.27);background:rgba(167,255,131,.09);color:var(--white)}.platform-tab svg{font-size:16px}.platform-tab span{font-size:13px;font-weight:650}.platform-tab small{display:grid;place-items:center;min-width:22px;height:22px;border-radius:999px;background:rgba(255,255,255,.07);color:#7d858e;font:500 9px var(--mono)}.client-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;align-content:start;padding:14px}.client-card{--rx:0deg;--ry:0deg;position:relative;display:grid;grid-template-columns:38px minmax(0,1fr) auto;align-items:center;gap:11px;min-height:72px;padding:12px;text-align:left;border:1px solid var(--line);border-radius:14px;background:rgba(10,13,16,.74);color:var(--white);cursor:pointer;transform:perspective(700px) rotateX(var(--rx)) rotateY(var(--ry));transition:transform .2s ease,border-color .22s ease,background .22s ease,box-shadow .22s ease}.client-card:after{border-radius:inherit}.client-card:hover{border-color:rgba(124,234,255,.42);background:rgba(17,22,26,.92);box-shadow:0 14px 30px rgba(0,0,0,.2)}.client-card.selected{border-color:rgba(167,255,131,.6);background:linear-gradient(120deg,rgba(167,255,131,.12),rgba(17,22,26,.9));box-shadow:inset 0 0 0 1px rgba(167,255,131,.06),0 12px 32px rgba(0,0,0,.22)}.client-glyph{display:grid;place-items:center;width:38px;height:38px;border-radius:11px;background:var(--acid);color:#07110b;font-size:19px;transition:transform .25s ease}.client-card:hover .client-glyph{transform:rotate(-7deg) scale(1.08)}.client-glyph.cyan{background:var(--cyan)}.client-glyph.violet{background:var(--violet)}.client-glyph.pink{background:#ff9bd3}.client-copy{min-width:0}.client-copy strong{display:block;overflow:hidden;font-size:14px;letter-spacing:-.02em;text-overflow:ellipsis;white-space:nowrap}.client-copy small{display:block;overflow:hidden;margin-top:4px;color:var(--muted);font:400 10px var(--mono);text-overflow:ellipsis;white-space:nowrap}.client-card em{padding:4px 6px;border-radius:6px;background:rgba(167,255,131,.08);color:var(--acid);font:500 8px var(--mono);font-style:normal;white-space:nowrap}
  .picker{margin-top:18px;padding:34px;border:1px solid var(--line);border-radius:22px;background:linear-gradient(145deg,rgba(20,25,29,.9),rgba(9,11,14,.9));transition:border-color .3s ease,box-shadow .3s ease}.picker:hover{border-color:rgba(255,255,255,.16);box-shadow:0 24px 70px rgba(0,0,0,.2)}.picker-head{display:flex;justify-content:space-between;align-items:flex-start;padding-bottom:28px;border-bottom:1px solid var(--line)}.picker-head small{color:var(--acid);font:500 9px var(--mono);letter-spacing:.15em}.picker-head h2{margin:9px 0 7px;font-size:36px;letter-spacing:-.05em}.picker-head p{margin:0;color:var(--muted)}.picker-head>a{display:flex;align-items:center;gap:8px;padding:10px 13px;border:1px solid var(--line);border-radius:10px;font-size:12px;transition:transform .22s ease,border-color .22s ease}.picker-head>a:hover{transform:translateY(-2px);border-color:var(--acid)}.pick-row{display:grid;grid-template-columns:140px 1fr;gap:20px;padding:21px 0;border-bottom:1px solid var(--line)}.pick-row>span{padding-top:11px;color:#697079;font:500 9px var(--mono);letter-spacing:.13em}.pick-row>div{display:flex;flex-wrap:wrap;gap:8px}.choice{display:flex;align-items:center;gap:8px;padding:10px 13px;border:1px solid var(--line);border-radius:10px;background:transparent;color:var(--muted);cursor:pointer;transition:transform .2s ease,border-color .2s ease,background .2s ease,color .2s ease}.choice:hover{transform:translateY(-2px)}.choice:hover,.choice.active{border-color:var(--acid);background:rgba(167,255,131,.08);color:var(--white)}
  .recommend{display:grid;grid-template-columns:56px 1fr auto;gap:18px;align-items:center;margin-top:25px;padding:19px;border:1px solid rgba(167,255,131,.3);border-radius:15px;background:rgba(167,255,131,.05);transition:transform .25s ease,background .25s ease}.recommend:hover{transform:translateY(-3px);background:rgba(167,255,131,.075)}.recommend-icon{display:grid;place-items:center;width:56px;height:56px;border-radius:15px;background:var(--acid);color:#08100b;font-size:25px}.recommend small{color:var(--acid);font:500 9px var(--mono);letter-spacing:.12em}.recommend h3{margin:6px 0;font-size:20px}.recommend p{margin:0;color:var(--muted);font:400 10px var(--mono)}.recommend i{color:#454b52}.recommend>a,.empty-release>a{display:flex;align-items:center;gap:8px;padding:13px 17px;border-radius:11px;background:var(--acid);color:#08100b;font-weight:700;transition:transform .22s ease,box-shadow .22s ease}.recommend>a:hover,.empty-release>a:hover{transform:translateY(-2px);box-shadow:0 12px 26px rgba(167,255,131,.17)}.picker details{margin-top:14px}.picker summary{display:flex;align-items:center;justify-content:space-between;padding:14px;color:var(--muted);font-size:12px;cursor:pointer}.alternatives{display:grid;gap:7px}.alternatives a{display:flex;align-items:center;justify-content:space-between;padding:14px;border:1px solid var(--line);border-radius:10px;transition:transform .2s ease,border-color .2s ease}.alternatives a:hover{transform:translateX(4px);border-color:var(--acid)}.alternatives span{display:flex;flex-direction:column;gap:3px}.alternatives small{color:var(--muted);font:400 9px var(--mono)}.empty-release{display:grid;grid-template-columns:50px 1fr auto;gap:20px;align-items:center;margin-top:26px;padding:22px;border:1px dashed var(--line);border-radius:14px}.empty-release>svg{color:var(--acid);font-size:32px}.empty-release h3{margin:0 0 6px}.empty-release p{margin:0;color:var(--muted);font-size:13px}
  @media(max-width:900px){.client-browser{grid-template-columns:1fr}.client-platforms{flex-direction:row;overflow-x:auto;border-right:0;border-bottom:1px solid var(--line)}.platform-tab{flex:0 0 auto;width:auto;grid-template-columns:18px auto auto}.client-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:650px){.client-grid{grid-template-columns:1fr}.client-card{min-height:68px}.picker{padding:24px}.picker-head{display:block}.picker-head>a{width:max-content;margin-top:20px}.pick-row{grid-template-columns:1fr;gap:8px}.recommend,.empty-release{grid-template-columns:52px 1fr}.recommend>a,.empty-release>a{grid-column:1/-1;justify-content:center}}
  @media(prefers-reduced-motion:reduce){.platform-tab,.client-card,.client-glyph,.picker,.picker-head>a,.choice,.recommend,.recommend>a,.empty-release>a,.alternatives a{transition:none!important;transform:none!important}}
</style>

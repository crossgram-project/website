---
import Base from '../layouts/Base.astro'
import Placeholder from '../components/Placeholder.astro'
import { Icon } from '../components/Icons'
import { featureGroups, matrix } from '../data/site'
const featureScreenshots = [
  '/screenshots/home/mobile-chat-list.webp',
  '/screenshots/home/mobile-forwarded-history.webp',
  '/screenshots/home/mobile-file-transfer.webp',
  '/screenshots/home/server-platform-account.webp',
]
const featurePositions = ['center 20%', 'center 54%', 'center', 'center']
const featureFits = ['contain', 'contain', 'contain', 'contain'] as const
---
<Base title="CrossGram — One client. Every conversation.">
  <section class="hero" data-scroll-scene>
    <div class="grid-field"></div>
    <div class="hero-inner wrap">
      <div class="hero-copy">
        <h1>ONE CLIENT.<br/><span>EVERY</span><br/>CONVERSATION.</h1>
        <p>把 QQ、Discord、Matrix 和更多聊天平台，带进你真正喜欢的 Telegram 客户端。</p>
        <div class="actions"><a class="button primary" href="/downloads">下载客户端 <Icon name="arrow" /></a><a class="button" href="/docs">开始部署</a></div>
      </div>
      <div class="hero-visual" data-reveal data-hero-gallery>
        <button class="shot-card shot-light front" type="button" data-hero-shot="0" aria-label="切换到贴纸面板截图" aria-pressed="true">
          <Placeholder label="Desktop sticker panel" src="/screenshots/home/desktop-sticker-panel.png" fit="contain" position="center" eager />
        </button>
        <button class="shot-card shot-dark rear" type="button" data-hero-shot="1" aria-label="切换到桌面聊天截图" aria-pressed="false">
          <Placeholder label="CrossGram Desktop / Unified Inbox" src="/screenshots/home/hero-unified-inbox.webp" fit="contain" position="center" eager />
        </button>
        <div class="shot-switch" aria-label="首屏截图切换">
          <button class="active" type="button" data-hero-dot="0" aria-label="显示贴纸面板截图"></button>
          <button type="button" data-hero-dot="1" aria-label="显示桌面聊天截图"></button>
        </div>
      </div>
    </div>
  </section>

  <div class="marquee" aria-hidden="true" data-marquee><div data-marquee-track>ONE PROTOCOL · EVERY PLATFORM · YOUR SERVER · YOUR CLIENT · </div></div>

  <section class="manifesto wrap" data-reveal data-scroll-scene>
    <p class="eyebrow">The interface is yours</p>
    <div><h2>聊天平台不该决定<br/>你使用什么界面。</h2><p>CrossGram 在你的服务器上把不同协议翻译成 MTProto。保留源平台的关系与内容，换成一个更快、更干净、更一致的客户端体验。</p></div>
  </section>

  <section class="story wrap" data-scroll-scene>
    <div class="story-visual" data-reveal data-tilt><Placeholder label="Native conversations / search / unread" kind="feature" src="/screenshots/home/native-conversations.webp" position="center" /></div>
    <article data-reveal>
      <span>01 / ONE INBOX</span>
      <h2>不同平台的群聊，排进同一份会话列表。</h2>
      <p>头像、消息预览、时间和未读数量都保留下来。打开客户端就能继续聊，不必先判断这条消息来自哪个应用。</p>
      <a href="#features">探索全部功能 <Icon name="arrow" /></a>
    </article>
  </section>

  <section class="platforms wrap" data-reveal data-scroll-scene>
    {['QQ / QQNT','DISCORD','MATRIX','SATORI'].map((name, i) => <div class="platform"><span>0{i+1}</span><strong>{name}</strong></div>)}
  </section>

  <section class="split-shots wrap" data-scroll-scene>
    <div class="split-copy" data-reveal><p class="eyebrow">More than plain text</p><h2>表情与贴纸，也应该保留原来的表达方式。</h2><p>Emoji 面板和贴纸包直接出现在客户端里。跨平台不意味着把每一条消息都降级成文字。</p></div>
    <div class="stack">
      <div class="stack-a portrait-shot" data-reveal data-tilt><Placeholder label="Emoji panel" kind="feature" src="/screenshots/home/mobile-emoji-panel.webp" position="center top" /></div>
      <div class="stack-b portrait-shot" data-reveal data-tilt><Placeholder label="Sticker pack" kind="feature" src="/screenshots/home/mobile-sticker-pack.webp" position="center top" /></div>
    </div>
  </section>

  <section class="feature-atlas wrap" id="features">
    <div class="feature-intro" data-reveal>
      <p class="eyebrow">Feature atlas / 04 systems</p>
      <h2>一套体验，<br/><span class="gradient-text">穿过所有平台。</span></h2>
      <p>从统一会话、富消息和文件传输，到自托管账号管理。这里展示的都是真实界面，而不是抽象功能列表。</p>
    </div>
    <div class="feature-list">
      {featureGroups.map((feature, index) => (
        <article class:list={['feature-row', { reverse: index % 2 }]} data-reveal data-scroll-scene>
          <div class="feature-copy">
            <span>{feature.kicker}</span>
            <h3>{feature.title}</h3>
            <p>{feature.body}</p>
            <ul>{feature.chips.map(chip => <li>{chip}</li>)}</ul>
          </div>
          <div class="feature-visual">
            <div class:list={['visual-note', `note-${index}`]}>{index === 0 ? 'NAGRAM / UNIFIED INBOX' : index === 1 ? 'FORWARDED HISTORY' : index === 2 ? 'DIRECT FILE TRANSFER' : 'SELF-HOSTED WEBUI'}</div>
            <div data-tilt><Placeholder label={`${feature.title} / ${feature.visual}`} kind="feature" src={featureScreenshots[index]} fit={featureFits[index]} position={featurePositions[index]} /></div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="matrix-section wrap" data-reveal data-scroll-scene>
    <div class="matrix-head"><div><p class="eyebrow">Compatibility matrix</p><h2>现在支持到哪里。</h2></div><p><b>●</b> 完整支持　<span>◐</span> 部分支持　<i>—</i> 暂不支持</p></div>
    <div class="matrix">
      <div class="matrix-row matrix-title"><strong>能力</strong><strong>QQ / QQNT</strong><strong>Discord</strong><strong>Matrix</strong></div>
      {matrix.map(row => <div class="matrix-row"><strong>{row[0]}</strong>{row.slice(1).map(status => <span class={status}>{status === 'full' ? '●' : status === 'partial' ? '◐' : '—'}</span>)}</div>)}
    </div>
    <p class="matrix-foot">Discord 适配器以普通用户账号自动化方式运行，可能违反 Discord 服务条款。请使用可承受风险的独立账号。</p>
  </section>

  <section class="deploy-band">
    <div class="deploy-grid"></div>
    <div class="wrap deploy-inner" data-reveal>
      <Icon name="server" size={44} />
      <h2>部署在你的服务器。<br/>连接到你的世界。</h2>
      <p>Linux 一键脚本快速上线 CrossGram Server 与 QQNT。Windows 提供完整的手动部署指南。</p>
      <a class="button primary" href="/docs">查看部署教程 <Icon name="arrow" /></a>
    </div>
  </section>
</Base>
<script>
  // Marquee: double the phrase until one half covers the band, then set the
  // loop duration from the measured half width so speed stays constant on any
  // screen width. Reduced-motion CSS (animation:none) still wins; the content
  // still covers statically.
  const marqueeBand = document.querySelector('[data-marquee]')
  const marqueeTrack = marqueeBand?.querySelector('[data-marquee-track]')
  if (marqueeBand instanceof HTMLElement && marqueeTrack instanceof HTMLElement) {
    const phrase = marqueeTrack.textContent ?? ''
    let lastBandWidth = 0
    const fill = () => {
      const bandWidth = marqueeBand.clientWidth
      if (bandWidth === lastBandWidth) return
      lastBandWidth = bandWidth
      marqueeTrack.textContent = phrase
      let guard = 0
      while (marqueeTrack.scrollWidth / 2 < bandWidth && guard++ < 12) {
        marqueeTrack.textContent += marqueeTrack.textContent
      }
      const halfWidth = marqueeTrack.scrollWidth / 2
      if (halfWidth <= 0) return
      const duration = `${Math.round(halfWidth / 17.2)}s`
      if (marqueeTrack.style.animationDuration !== duration) {
        marqueeTrack.style.animationDuration = duration
      }
    }
    fill()
    document.fonts?.ready.then(fill)
    let resizeTimer: number | undefined
    addEventListener('resize', () => {
      window.clearTimeout(resizeTimer)
      resizeTimer = window.setTimeout(fill, 200)
    }, { passive: true })
  }

  const gallery = document.querySelector('[data-hero-gallery]')
  if (gallery instanceof HTMLElement) {
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)')
    const shuffleDuration = 950
    const shots = [...gallery.querySelectorAll<HTMLElement>('[data-hero-shot]')]
    const dots = [...gallery.querySelectorAll<HTMLElement>('[data-hero-dot]')]
    let active = 0
    let timer: number | undefined
    let queued: number | undefined
    let galleryVisible = true

    const applyActive = () => {
      shots.forEach((shot, index) => {
        const selected = index === active
        shot.classList.toggle('front', selected)
        shot.classList.toggle('rear', !selected)
        shot.setAttribute('aria-pressed', String(selected))
      })
      dots.forEach((dot, index) => dot.classList.toggle('active', index === active))
    }

    const show = (next: number) => {
      const target = (next + shots.length) % shots.length
      if (target === active && !gallery.classList.contains('swapping')) return
      queued = target
      if (gallery.classList.contains('swapping')) return
      if (queued === undefined) return
      const nextTarget = queued
      queued = undefined
      if (nextTarget === active) return
      if (reducedMotion.matches) {
        active = nextTarget
        applyActive()
        return
      }
      const previous = active
      // Deal from the current slots: keyframes carry the slot difference via
      // translate deltas measured at deal time, so nothing teleports at t=0
      // and the path stays smooth across container widths. front/rear classes
      // flip only when the deal settles.
      gallery.classList.add('swapping')
      // Both end frames are anchor-aligned to their steady-state slots (deal-out
      // flips to bottom-anchored rear, deal-in to top-anchored front, each with
      // translate(0,0)); the mid-flight rise/fall is carried by --deal-dy, the
      // full layout delta between the two slots.
      const slotTop = (card: HTMLElement, slot: 'front' | 'rear') => {
        const style = getComputedStyle(card)
        if (slot === 'front') return parseFloat(style.getPropertyValue('--front-top'))
        return gallery.offsetHeight - parseFloat(style.getPropertyValue('--rear-bottom')) - card.offsetHeight
      }
      const dyOut = slotTop(shots[previous], 'rear') - shots[previous].offsetTop
      const dyIn = slotTop(shots[nextTarget], 'front') - slotTop(shots[nextTarget], 'rear')
      shots[previous].style.setProperty('--deal-dy', `${dyOut}px`)
      shots[nextTarget].style.setProperty('--deal-dy', `${dyIn}px`)
      shots[nextTarget].style.setProperty('--deal-from-top', `${shots[nextTarget].offsetTop}px`)
      shots[nextTarget].classList.add('deal-in')
      shots[previous].classList.add('deal-out')
      active = nextTarget
      shots[nextTarget].setAttribute('aria-pressed', 'true')
      shots[previous].setAttribute('aria-pressed', 'false')
      dots.forEach((dot, index) => dot.classList.toggle('active', index === active))
      let settled = false
      const settle = () => {
        if (settled) return
        settled = true
        window.clearTimeout(settleTimer)
        gallery.classList.remove('swapping')
        // The base .shot-card transition would otherwise glide each card from
        // the keyframe end-frame to its steady-state slot; snap instead.
        gallery.classList.add('settling')
        shots.forEach(shot => {
          shot.classList.remove('deal-out', 'deal-in')
          shot.style.removeProperty('--deal-dy')
          shot.style.removeProperty('--deal-from-top')
        })
        applyActive()
        requestAnimationFrame(() => requestAnimationFrame(() => gallery.classList.remove('settling')))
        // Drain any target queued mid-deal: the last click always wins.
        if (queued !== undefined) {
          const next = queued
          queued = undefined
          show(next)
        }
      }
      shots[nextTarget].addEventListener('animationend', event => {
        if (event.animationName === 'hero-deal-in') settle()
      }, { once: true })
      // animationend can be dropped (display:none, reduced-motion change, hidden
      // tab): fall back to the animation duration so the queue never wedges.
      const settleTimer = window.setTimeout(settle, shuffleDuration + 250)
    }

    const stopAutoplay = () => {
      window.clearInterval(timer)
      timer = undefined
    }
    const startAutoplay = () => {
      if (timer !== undefined || reducedMotion.matches || document.hidden || !galleryVisible) return
      timer = window.setInterval(() => show(active + 1), 4800)
    }
    const restartAutoplay = () => {
      stopAutoplay()
      startAutoplay()
    }

    shots.forEach((shot, index) => shot.addEventListener('click', () => {
      show(index === active ? active + 1 : index)
      restartAutoplay()
    }))
    dots.forEach((dot, index) => dot.addEventListener('click', event => {
      event.stopPropagation()
      show(index)
      restartAutoplay()
    }))
    gallery.addEventListener('pointerenter', stopAutoplay)
    gallery.addEventListener('pointerleave', startAutoplay)

    // Pause the interval while the tab is hidden or the gallery is scrolled away,
    // so a parked tab stops scheduling work and can be collected.
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        stopAutoplay()
      } else {
        startAutoplay()
      }
    })
    reducedMotion.addEventListener('change', () => {
      stopAutoplay()
      gallery.classList.remove('swapping')
      shots.forEach(shot => shot.classList.remove('deal-out', 'deal-in'))
      queued = undefined
      applyActive()
      startAutoplay()
    })
    new IntersectionObserver(entries => entries.forEach(entry => {
      galleryVisible = entry.isIntersecting
      if (galleryVisible) startAutoplay()
      else stopAutoplay()
    })).observe(gallery)

    startAutoplay()

    // Astro page transitions / bfcache: release the interval and any pending
    // timeout so the detached page holds no live timers.
    addEventListener('pagehide', () => {
      stopAutoplay()
    }, { once: true })
  }

  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const root = document.documentElement
    const scrollScenes = [...document.querySelectorAll<HTMLElement>('[data-scroll-scene]')]
    let ticking = false
    const updateScroll = () => {
      const y = scrollY
      const heroProgress = Math.min(1, y / Math.max(1, innerHeight * .9))
      root.style.setProperty('--page-scroll', `${y}px`)
      root.style.setProperty('--hero-copy-y', `${heroProgress * -34}px`)
      root.style.setProperty('--hero-image-y', `${heroProgress * 54}px`)
      root.style.setProperty('--hero-image-scale', String(1 - heroProgress * .035))
      root.style.setProperty('--hero-copy-opacity', String(1 - heroProgress * .2))
      scrollScenes.forEach(scene => {
        const box = scene.getBoundingClientRect()
        const center = box.top + box.height / 2
        const progress = Math.max(-1, Math.min(1, (innerHeight / 2 - center) / (innerHeight + box.height) * 2))
        scene.style.setProperty('--scene-up-20', `${progress * -20}px`)
        scene.style.setProperty('--scene-up-24', `${progress * -24}px`)
        scene.style.setProperty('--scene-up-35', `${progress * -35}px`)
        scene.style.setProperty('--scene-up-48', `${progress * -48}px`)
        scene.style.setProperty('--scene-up-55', `${progress * -55}px`)
        scene.style.setProperty('--scene-down-22', `${progress * 22}px`)
        scene.style.setProperty('--scene-down-24', `${progress * 24}px`)
        scene.style.setProperty('--scene-down-30', `${progress * 30}px`)
        scene.style.setProperty('--scene-down-34', `${progress * 34}px`)
        scene.style.setProperty('--scene-down-42', `${progress * 42}px`)
        scene.style.setProperty('--scene-rotate', `${progress}deg`)
        scene.style.setProperty('--scene-rotate-double', `${progress * 2}deg`)
        scene.style.setProperty('--scene-rotate-half', `${progress * -1.5}deg`)
        scene.style.setProperty('--scene-rotate-neg', `${progress * -1}deg`)
        scene.style.setProperty('--scene-rotate-neg-double', `${progress * -2}deg`)
      })
      ticking = false
    }
    const requestScrollUpdate = () => {
      if (ticking) return
      ticking = true
      requestAnimationFrame(updateScroll)
    }
    addEventListener('scroll', requestScrollUpdate, { passive: true })
    addEventListener('resize', requestScrollUpdate, { passive: true })
    requestScrollUpdate()
  }
</script>
<style>
  .hero{position:relative;min-height:900px;padding-top:125px;overflow:hidden}.hero:after{content:"";position:absolute;z-index:-2;right:-8vw;top:10vh;width:60vw;height:60vw;border-radius:50%;background:conic-gradient(from 20deg,var(--violet),transparent 25%,var(--cyan),transparent 57%,var(--acid));filter:blur(100px);opacity:.13;animation:spin 22s linear infinite;translate:0 var(--scene-down-42,0px)}.hero-inner{position:relative;min-height:780px}.hero-copy{position:relative;z-index:5;width:47%;padding-top:82px;pointer-events:none;transform:translate3d(0,var(--hero-copy-y,0px),0);opacity:var(--hero-copy-opacity,1)}.hero-copy .actions,.hero-copy>p{pointer-events:auto}.hero h1{margin:0;font-size:clamp(58px,7.8vw,118px);line-height:.8;letter-spacing:-.08em}.hero h1 span{position:relative;z-index:7;color:#fff;mix-blend-mode:difference}.hero-copy>p{max-width:500px;margin:38px 0 25px;color:#b2b8bf;font-size:18px;line-height:1.7}.actions{display:flex;gap:10px}.hero-visual{position:absolute;z-index:6;right:-4%;top:145px;width:62%;height:610px;isolation:isolate;transform:translate3d(0,var(--hero-image-y,0px),0) scale(var(--hero-image-scale,1))}.shot-card{position:absolute;display:block;overflow:hidden;padding:0;border:1px solid rgba(255,255,255,.2);border-radius:24px;background:transparent;backdrop-filter:blur(7px);box-shadow:-30px 55px 110px rgba(0,0,0,.46),0 0 70px rgba(124,234,255,.07);cursor:pointer;will-change:transform,opacity;transition:transform .95s cubic-bezier(.2,.82,.16,1),opacity .58s ease,filter .58s ease,box-shadow .4s ease;transform-origin:bottom right}.shot-light{width:88%;aspect-ratio:2140/1202}.shot-dark{width:78%;aspect-ratio:1682/1230}.shot-card.front{z-index:2;filter:none}.shot-card.rear{z-index:1}.shot-card.shot-light.front{right:4%;top:-8px;transform:rotate(-1.4deg)}.shot-card.shot-light.rear{right:12%;top:auto;bottom:70px;transform:rotate(2.2deg) scale(.86);opacity:.38;filter:saturate(.6) brightness(.55)}.shot-card.shot-dark.front{right:4%;top:-32px;transform:rotate(1.4deg)}.shot-card.shot-dark.rear{right:12%;top:auto;bottom:52px;transform:rotate(-2.2deg) scale(.86);opacity:.38;filter:saturate(.6) brightness(.55)}.shot-card.deal-out{z-index:3;animation:hero-deal-out .95s cubic-bezier(.6,.04,.68,.4) both}.shot-card.deal-in{z-index:1;animation:hero-deal-in .95s cubic-bezier(.16,.66,.3,1) both}.hero-visual.swapping{pointer-events:none}.hero-visual.settling .shot-card{transition:none}.shot-card:hover{box-shadow:-30px 65px 125px rgba(0,0,0,.58),0 0 95px rgba(124,234,255,.12)}.hero-visual:not(.swapping) .shot-card.rear:hover{opacity:.6;filter:saturate(.8) brightness(.75)}.shot-card :global(.placeholder){position:absolute;inset:0;min-height:0;width:100%;height:100%;border:0;border-radius:23px;background:transparent;box-shadow:none}.shot-card :global(.placeholder img){inset:0;width:100%;height:100%;object-fit:contain;object-position:center}.shot-switch{position:absolute;z-index:12;right:26px;bottom:0;display:flex;gap:7px;padding:8px 10px;border:1px solid rgba(255,255,255,.13);border-radius:999px;background:rgba(5,7,9,.72);backdrop-filter:blur(12px)}.shot-switch button{width:7px;height:7px;padding:0;border:0;border-radius:99px;background:#697079;cursor:pointer;transition:width .25s ease,background .25s ease}.shot-switch button.active{width:24px;background:var(--acid)}
  .marquee{overflow:hidden;border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:rgba(255,255,255,.025);transform:rotate(-1.5deg) scale(1.02)}.marquee div{width:max-content;padding:17px 0;color:var(--acid);font:500 11px var(--mono);letter-spacing:.2em;animation:marquee 60s linear infinite}
  .manifesto{padding:180px 0;display:grid;grid-template-columns:1fr 2fr;gap:50px;translate:0 var(--scene-up-24,0px)}.manifesto h2{margin:0;font-size:clamp(38px,5vw,68px);line-height:1.05;letter-spacing:-.055em}.manifesto div p{max-width:650px;margin:34px 0 0;color:var(--muted);font-size:19px;line-height:1.75}

---
interface Props { label: string; kind?: 'wide' | 'phone' | 'feature' }
const { label, kind = 'wide' } = Astro.props
---
<div class:list={['placeholder', kind]} role="img" aria-label={`${label} 产品截图占位图`}>
  <span class="crosshair a"></span><span class="crosshair b"></span>
  <div class="placeholder-copy"><small>SCREENSHOT / PLACEHOLDER</small><strong>{label}</strong><em>Replace this frame with product capture</em></div>
</div>
<style>
  .placeholder{position:relative;overflow:hidden;min-height:480px;border:1px solid rgba(255,255,255,.16);border-radius:24px;background:#000;box-shadow:0 40px 100px rgba(0,0,0,.55)}
  .placeholder:before{content:"";position:absolute;inset:18px;border:1px solid rgba(255,255,255,.09);border-radius:14px}.placeholder:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,transparent 49.9%,rgba(255,255,255,.05) 50%,transparent 50.1%),linear-gradient(0deg,transparent 49.9%,rgba(255,255,255,.05) 50%,transparent 50.1%)}
  .placeholder-copy{position:absolute;z-index:2;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;opacity:.32;transition:opacity .3s ease}.placeholder:hover .placeholder-copy{opacity:.48}.placeholder small{font:500 10px/1 var(--mono);letter-spacing:.22em;color:var(--acid)}.placeholder strong{margin-top:15px;font-size:clamp(22px,3vw,42px);letter-spacing:-.04em}.placeholder em{margin-top:8px;color:#8b9096;font:400 11px/1 var(--mono)}
  .crosshair{position:absolute;width:13px;height:13px;border-color:#60646b}.crosshair.a{top:28px;left:28px;border-top:1px solid;border-left:1px solid}.crosshair.b{right:28px;bottom:28px;border-right:1px solid;border-bottom:1px solid}
  .phone{min-height:600px;border-radius:38px}.feature{min-height:390px}
</style>

---
import { Image } from 'astro:assets'
import { screenshots } from '../data/screenshots'
interface Props { label: string; kind?: 'wide' | 'phone' | 'feature'; src?: string; alt?: string; fit?: 'cover' | 'contain'; position?: string; eager?: boolean }
const { label, kind = 'wide', src, alt = label, fit = 'cover', position = 'center', eager = false } = Astro.props
const image = src ? screenshots[src] : undefined
---
<div class:list={['placeholder', kind]} style={`--image-fit:${fit};--image-position:${position}`} role={src ? undefined : 'img'} aria-label={src ? undefined : `${label} 产品截图占位图`}>
  {image && <Image src={image} alt={alt} widths={[420, 768, 1280]} sizes="(max-width: 600px) 90vw, 60vw" loading={eager ? 'eager' : 'lazy'} decoding="async" onload="this.parentElement.classList.add('image-loaded')" onerror="this.remove()" />}
  <span class="crosshair a"></span><span class="crosshair b"></span>
  <div class="placeholder-copy"><small>SCREENSHOT / PLACEHOLDER</small><strong>{label}</strong><em>Replace this frame with product capture</em></div>
</div>
<style>
  .placeholder{position:relative;overflow:hidden;min-height:480px;border:1px solid rgba(255,255,255,.16);border-radius:24px;background:#000;box-shadow:0 40px 100px rgba(0,0,0,.55)}
  .placeholder:before{content:"";position:absolute;inset:18px;border:1px solid rgba(255,255,255,.09);border-radius:14px}.placeholder:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,transparent 49.9%,rgba(255,255,255,.05) 50%,transparent 50.1%),linear-gradient(0deg,transparent 49.9%,rgba(255,255,255,.05) 50%,transparent 50.1%)}
  .placeholder.image-loaded:before{z-index:2;inset:0;border:0;border-radius:inherit;background:linear-gradient(125deg,rgba(255,255,255,.12),transparent 22%,transparent 72%,rgba(167,255,131,.06));pointer-events:none}.placeholder.image-loaded:after{z-index:2;background:radial-gradient(320px circle at var(--shine-x,-100px) var(--shine-y,-100px),rgba(255,255,255,.09),transparent 46%);pointer-events:none}.placeholder img{position:absolute;inset:0;width:100%;height:100%;object-fit:var(--image-fit);object-position:var(--image-position);transition:transform .7s cubic-bezier(.2,.8,.2,1),filter .45s ease}.placeholder:hover img{transform:scale(1.018);filter:saturate(1.08) brightness(1.04)}
  .placeholder-copy{position:absolute;z-index:2;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;opacity:.32;transition:opacity .3s ease}.placeholder:hover .placeholder-copy{opacity:.48}.placeholder.image-loaded .placeholder-copy,.placeholder.image-loaded .crosshair{opacity:0;pointer-events:none}.placeholder small{font:500 10px/1 var(--mono);letter-spacing:.22em;color:var(--acid)}.placeholder strong{margin-top:15px;font-size:clamp(22px,3vw,42px);letter-spacing:-.04em}.placeholder em{margin-top:8px;color:#8b9096;font:400 11px/1 var(--mono)}
  .crosshair{position:absolute;width:13px;height:13px;border-color:#60646b}.crosshair.a{top:28px;left:28px;border-top:1px solid;border-left:1px solid}.crosshair.b{right:28px;bottom:28px;border-right:1px solid;border-bottom:1px solid}
  .phone{min-height:600px;border-radius:38px}.feature{min-height:390px}
</style>

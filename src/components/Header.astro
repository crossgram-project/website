---
import { nav } from '../data/site'
import { Icon } from './Icons'
const pathname = Astro.url.pathname

const progressiveBlurHeight = 70
const progressiveBlurAmount = 40
const fineLayers = progressiveBlurHeight < 100
  ? Math.ceil(Math.floor(progressiveBlurHeight / 4) / 2)
  : 15
let remainingHeight = progressiveBlurHeight
let layerIndex = 1
const progress: number[] = []
while (remainingHeight > 0) {
  remainingHeight -= layerIndex <= fineLayers
    ? 2
    : Math.pow(layerIndex - fineLayers + 1, 2)
  progress.push(Math.min(1, (progressiveBlurHeight - Math.max(0, remainingHeight)) / progressiveBlurHeight))
  layerIndex++
}
const variance = progress.reduce((sum, value) => sum + value * value, 0)
const blurScale = progressiveBlurAmount / Math.sqrt(variance)
remainingHeight = progressiveBlurHeight
const progressiveBlurLayers = progress.map((value, index) => {
  remainingHeight -= index + 1 <= fineLayers
    ? 2
    : Math.pow(index + 1 - fineLayers + 1, 2)
  return {
    id: index + 1,
    height: Math.max(0, remainingHeight),
    blur: value * blurScale,
  }
}).reverse()
---
<header class="header">
  <div class="progressive-blur" aria-hidden="true" style={`height:${progressiveBlurHeight}px`}>
    {progressiveBlurLayers.map((layer, index) => (
      <i
        data-progressive-blur-layer
        data-blur={layer.blur.toFixed(3)}
        style={`height:${layer.height}px;backdrop-filter:blur(${layer.blur}px);-webkit-backdrop-filter:blur(${layer.blur}px);background:${index === progressiveBlurLayers.length - 1 ? 'linear-gradient(180deg,rgba(13,16,20,.72),transparent)' : 'transparent'}`}
      ></i>
    ))}
  </div>
  <div class="glass-glow"></div>
  <a class="brand" href="/" aria-label="CrossGram 首页">
    <span class="brand-mark"><Icon name="telegram" size={20} /></span>
    <span>CrossGram</span>
  </a>
  <nav aria-label="主导航">
    {nav.map((item) => <a class:list={{ active: item.href === '/' ? pathname === '/' : (!item.href.includes('#') && pathname.startsWith(item.href)) }} href={item.href}>{item.label}</a>)}
  </nav>
  <a class="header-github" href="https://github.com/crossgram-project/website"><Icon name="github" /><span>GitHub</span></a>
</header>

<style>
  .header{position:fixed;z-index:30;top:0;left:0;isolation:isolate;width:100%;height:76px;display:flex;align-items:center;justify-content:space-between;padding:0 max(22px,calc((100vw - 1160px)/2));border:0;border-radius:0;background:rgba(13,16,20,.12);box-shadow:none;overflow:visible}
  .progressive-blur{position:absolute;z-index:-4;top:0;right:0;left:0;pointer-events:none}.progressive-blur i{position:absolute;top:0;right:0;left:0;display:block;will-change:backdrop-filter}
  .header:before{content:"";position:absolute;z-index:-1;inset:0;background:linear-gradient(100deg,transparent 10%,rgba(255,255,255,.13) 36%,transparent 58%);transform:translateX(-120%);animation:glass-sweep 8s ease-in-out infinite}
  .glass-glow{position:absolute;z-index:-2;left:20%;top:-100px;width:45%;height:150px;background:linear-gradient(90deg,var(--violet),var(--cyan),var(--acid));filter:blur(45px);opacity:.2;animation:glass-drift 10s ease-in-out infinite alternate}
  .brand{display:flex;align-items:center;gap:10px;color:var(--white);font-weight:760;letter-spacing:-.03em}.brand-mark{display:grid;place-items:center;width:36px;height:36px;border-radius:12px;background:linear-gradient(145deg,#d6ffc7,var(--acid));color:#07110b;box-shadow:0 7px 24px rgba(167,255,131,.28);transform:rotate(-5deg);transition:.3s}.brand:hover .brand-mark{transform:rotate(6deg) scale(1.06)}
  nav{display:flex;gap:4px;padding:4px;border:1px solid rgba(255,255,255,.07);border-radius:13px;background:rgba(0,0,0,.12)}nav a{position:relative;padding:9px 15px;border-radius:9px;color:#c1c7ce;font-size:13px;transition:.25s}nav a:hover,nav a.active{background:rgba(255,255,255,.11);color:var(--white);box-shadow:inset 0 1px rgba(255,255,255,.12)}
  .header-github{display:flex;align-items:center;gap:8px;padding:10px 14px;border:1px solid rgba(255,255,255,.3);border-radius:12px;background:rgba(255,255,255,.88);color:#0a0b0d;font-size:14px;font-weight:700;box-shadow:0 7px 24px rgba(0,0,0,.16);transition:.25s;transform:translate(var(--magnetic-x,0),var(--magnetic-y,0))}.header-github:hover{transform:translate(var(--magnetic-x,0),calc(var(--magnetic-y,0) - 2px));background:#fff}
  @keyframes glass-sweep{0%,55%{transform:translateX(-120%)}80%,100%{transform:translateX(150%)}}@keyframes glass-drift{to{left:48%;transform:scale(1.25)}}
  @media(max-width:700px){.header{height:64px;padding-inline:14px}.header nav{display:none}.header-github span{display:none}.header-github{padding:10px}.brand{font-size:15px}.glass-glow{opacity:.12}}
  @media(prefers-reduced-motion:reduce){.header:before,.glass-glow{animation:none}}
</style>

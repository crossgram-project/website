---
import { nav } from '../data/site'
import { Icon } from './Icons'
const pathname = Astro.url.pathname
---
<header class="header">
  <div class="glass-glow"></div>
  <a class="brand" href="/" aria-label="CrossGram 首页">
    <span class="brand-mark"><Icon name="telegram" size={20} /></span>
    <span>CrossGram</span>
  </a>
  <nav aria-label="主导航">
    {nav.map((item) => <a class:list={{ active: pathname === item.href || (item.href !== '/' && pathname.startsWith(item.href)) }} href={item.href}>{item.label}</a>)}
  </nav>
  <a class="header-github" href="https://github.com/crossgram-project/website"><Icon name="github" /><span>GitHub</span></a>
</header>

<style>
  .header{position:fixed;z-index:30;top:0;left:0;isolation:isolate;width:100%;height:76px;display:flex;align-items:center;justify-content:space-between;padding:0 max(22px,calc((100vw - 1160px)/2));border:0;border-bottom:1px solid rgba(255,255,255,.13);border-radius:0;background:linear-gradient(180deg,rgba(13,16,20,.86),rgba(13,16,20,.58) 72%,rgba(13,16,20,.18));backdrop-filter:blur(24px) saturate(150%);-webkit-backdrop-filter:blur(24px) saturate(150%);box-shadow:0 18px 50px rgba(0,0,0,.18);overflow:visible}
  .header:after{content:"";position:absolute;z-index:-3;top:100%;left:0;width:100%;height:34px;pointer-events:none;background:linear-gradient(180deg,rgba(13,16,20,.23),transparent);backdrop-filter:blur(13px);-webkit-backdrop-filter:blur(13px);mask-image:linear-gradient(#000,transparent);-webkit-mask-image:linear-gradient(#000,transparent)}
  .header:before{content:"";position:absolute;z-index:-1;inset:0;background:linear-gradient(100deg,transparent 10%,rgba(255,255,255,.13) 36%,transparent 58%);transform:translateX(-120%);animation:glass-sweep 8s ease-in-out infinite}
  .glass-glow{position:absolute;z-index:-2;left:20%;top:-100px;width:45%;height:150px;background:linear-gradient(90deg,var(--violet),var(--cyan),var(--acid));filter:blur(45px);opacity:.2;animation:glass-drift 10s ease-in-out infinite alternate}
  .brand{display:flex;align-items:center;gap:10px;color:var(--white);font-weight:760;letter-spacing:-.03em}.brand-mark{display:grid;place-items:center;width:36px;height:36px;border-radius:12px;background:linear-gradient(145deg,#d6ffc7,var(--acid));color:#07110b;box-shadow:0 7px 24px rgba(167,255,131,.28);transform:rotate(-5deg);transition:.3s}.brand:hover .brand-mark{transform:rotate(6deg) scale(1.06)}
  nav{display:flex;gap:4px;padding:4px;border:1px solid rgba(255,255,255,.07);border-radius:13px;background:rgba(0,0,0,.12)}nav a{position:relative;padding:9px 15px;border-radius:9px;color:#c1c7ce;font-size:13px;transition:.25s}nav a:hover,nav a.active{background:rgba(255,255,255,.11);color:var(--white);box-shadow:inset 0 1px rgba(255,255,255,.12)}
  .header-github{display:flex;align-items:center;gap:8px;padding:10px 14px;border:1px solid rgba(255,255,255,.3);border-radius:12px;background:rgba(255,255,255,.88);color:#0a0b0d;font-size:14px;font-weight:700;box-shadow:0 7px 24px rgba(0,0,0,.16);transition:.25s}.header-github:hover{transform:translateY(-2px);background:#fff}
  @keyframes glass-sweep{0%,55%{transform:translateX(-120%)}80%,100%{transform:translateX(150%)}}@keyframes glass-drift{to{left:48%;transform:scale(1.25)}}
  @media(max-width:700px){.header{height:64px;padding-inline:14px}.header nav{display:none}.header-github span{display:none}.header-github{padding:10px}.brand{font-size:15px}.glass-glow{opacity:.12}}
  @media(prefers-reduced-motion:reduce){.header:before,.glass-glow{animation:none}}
</style>
